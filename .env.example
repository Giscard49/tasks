DATABASE_URL="postgresql://postgres.fzfjotcsosnkjlyhmmhj:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432), used by Prisma for migrations/schema pushes:
